{
	"manifest_version": 3,
	"version": "1.2",
	"name": "speedyVid - speed up videos",
	"description": "Control HTML5 video speed without shady side effects.",
	"permissions": [
		"storage",
		"activeTab",
		"tabs"
	],
	"action": {
		"default_popup": "popup.html"
	},
  "background": {
		"service_worker": "background.js"
	},
	"content_scripts": [
		{
			"matches": [
				"<all_urls>"
			],
			"js": [
				"content.js"
			]
		}
	]
}